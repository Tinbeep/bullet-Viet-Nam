<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Bullet Viet Nam</title>

<style>

body{
    background:#f4f4f4;
    font-family:Arial,Helvetica,sans-serif;
}

.sidebar{
    width:340px;
    background:white;
    margin:30px auto;
    border-radius:30px;
    padding:25px;
    box-shadow:0 10px 30px rgba(0,0,0,.15);
}

.logo{
    font-size:48px;
    text-align:center;
}

.club-name{
    text-align:center;
    color:#ff2f92;
    font-size:30px;
    font-weight:bold;
}

.slogan{
    text-align:center;
    color:#777;
    margin-bottom:25px;
}

.stats{
    display:flex;
    justify-content:space-between;
    margin-bottom:25px;
}

.item{
    text-align:center;
    flex:1;
}

.item h2{
    color:#ff2f92;
    margin:0;
}

.item p{
    margin:5px 0;
    color:#666;
}

.title{
    text-align:center;
    color:#ff2f92;
    font-weight:bold;
    margin:20px 0;
}

.buttons{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px;
}

.btn{
    background:#ff4fa5;
    color:white;
    padding:12px;
    text-align:center;
    border-radius:25px;
    font-weight:bold;
}

.website{
    margin-top:18px;
    background:linear-gradient(90deg,#8e44ff,#ff4fa5);
    color:white;
    text-align:center;
    padding:14px;
    border-radius:30px;
    font-weight:bold;
}

.box{
    margin-top:25px;
    background:#fafafa;
    border-radius:20px;
    padding:18px;
}

.progress{
    width:100%;
    height:16px;
    background:#ddd;
    border-radius:30px;
    overflow:hidden;
    margin:10px 0;
}

.bar{
    width:12%;
    height:100%;
    background:#ff4fa5;
}

.schedule{
    margin-top:10px;
}

.day{
    background:#f6ecff;
    border-left:6px solid #b64cff;
    padding:12px;
    border-radius:15px;
    margin-bottom:10px;
}

.day b{
    color:#ff2f92;
}

</style>

</head>

<body>

<div class="sidebar">

<div class="logo">♟️</div>

